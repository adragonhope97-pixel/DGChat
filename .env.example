# DGChat 环境变量示例（复制为 .env 使用；真实密钥严禁提交仓库）
# docker compose 会自动读取同目录 .env

# —— 基础 ——
PORT=3000
APP_NAME=DGChat
# 数据目录（默认 ./data；Docker 内为 /app/data）
# DATA_DIR=./data

# —— 安全 ——
# 部署在 Nginx/Caddy 反代之后时设 1（限流取真实 IP；HTTPS 透传后 HSTS 自动启用）
TRUST_PROXY=0
# 额外放行的跨域来源（逗号分隔；Capacitor/ionic WebView 来源默认已放行）
CORS_ORIGINS=
# 无 HTTPS 代理却要强制 HSTS 时设 1（本机 HTTP 调试勿开）
FORCE_HSTS=0

# —— 会话与防爆破 ——
SESSION_TTL_MS=2592000000
LOGIN_MAX_FAILS=10
LOGIN_LOCK_MS=900000

# —— 可选：校园邮箱 SMTP（2.5 预留；未配置时邮箱验证走域名匹配+人工审核） ——
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
